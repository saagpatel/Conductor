+def _interruptible_sleep(seconds: float, cancel: threading.Event | None) -> str | None:
+    """C5's retry backoff: sleeps in one-second steps so a stop request or
+    the lane's own cancel event ends it exactly the way it would end a
+    running dispatch, instead of a plain `time.sleep` that only notices
+    afterwards. Returns the reason the sleep ended early, or None once it
+    ran its full course with neither ever firing."""
+    remaining = seconds
+    while remaining > 0:
+        if stop_requested():
+            return "interrupted: stop requested during retry backoff"
+        if cancel is not None and cancel.is_set():
+            return "cancelled: another lane already passed"
+        time.sleep(min(1.0, remaining))
+        remaining -= 1.0
+    if stop_requested():
+        return "interrupted: stop requested during retry backoff"
+    if cancel is not None and cancel.is_set():
+        return "cancelled: another lane already passed"
+    return None
+
