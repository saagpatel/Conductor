+def _errors_summary(lane_results: list[LaneResult]) -> dict[str, int]:
+    """C5: kind -> count, over every attempt (retries included) of every
+    lane; empty when nothing failed."""
+    counts: dict[str, int] = {}
+    for lane in lane_results:
+        for kind in lane.kinds:
+            if kind:
+                counts[kind] = counts.get(kind, 0) + 1
+    return counts
+
