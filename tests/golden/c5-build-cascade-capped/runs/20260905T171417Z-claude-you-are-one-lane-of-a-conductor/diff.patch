+def test_conductor_missions_and_runs_expose_kind_and_errors(
+    repo: Path, home: Path, fake_fleet, capsys
+) -> None:
+    from conductor import cli
+
+    fake_fleet(argv=["sh", "-c", "exit 1"])
+    mission = mission_from_dict(
+        {
+            "cwd": str(repo),
+            "lanes": [{"name": "build", "fleet": "claude", "mode": "write", "prompt": "do it"}],
+        },
+        base_dir=Path("."),
+    )
+    run_mission(mission, home=home)
+    import argparse
+
+    home.mkdir(parents=True, exist_ok=True)
+
+    def _conductor_home() -> Path:
+        return home
+
+    import conductor.cli as cli_mod
+
+    original = cli_mod.conductor_home
+    cli_mod.conductor_home = _conductor_home
+    try:
+        cli.cmd_missions(argparse.Namespace(limit=10))
+        missions_out = json.loads(capsys.readouterr().out)
+        assert missions_out[0]["errors"] == {"exit": 1}
+
+        cli.cmd_runs(argparse.Namespace(limit=10))
+        runs_out = json.loads(capsys.readouterr().out)
+        assert any(row.get("kind") == "exit" for row in runs_out)
+    finally:
+        cli_mod.conductor_home = original
