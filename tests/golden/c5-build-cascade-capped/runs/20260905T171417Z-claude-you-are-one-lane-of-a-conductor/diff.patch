diff --git a/src/conductor/errors.py b/src/conductor/errors.py
new file mode 100644
index 0000000..cff2d8a
--- /dev/null
+++ b/src/conductor/errors.py
@@ -0,0 +1,215 @@
+"""Structured error kinds: one label for why a dispatch was not ok.
+
+`runner.Result.failure()` already reduces a dispatch to one line of prose, but
+that line is meant for a human, and two very different failures ("a rate
+limit" and "a broken gate") can share nearly identical wording. `error_kind`
+classifies a result into exactly one of `KINDS`, checked in a fixed order so a
+dispatch that matches more than one reason (a cap kill that also timed out) is
+still exactly one kind: the first one that matches. Mission fallbacks (C5
+item 2) and retries (item 3) key off this label instead of re-parsing prose.
+
+`error_kind` accepts either a `runner.Result` or the plain dict a receipt
+(`result.json`) deserializes to, since `conductor runs` reads receipts off
+disk without reconstructing a `Result` object.
+"""
+
+from __future__ import annotations
+
+KINDS: tuple[str, ...] = (
+    "interrupted",
+    "cancelled",
+    "cap",
+    "breaker",
+    "timeout",
+    "setup",
+    "refused",
+    "rate_limit",
+    "transport",
+    "refusal",
+    "fleet_error",
+    "exit",
+    "gate",
+    "no_op",
+    "read_moved_bytes",
+    "no_answer",
+    "commit",
+    "unknown",
+)
+
+# Claude's own budget/turn stops use this subtype prefix but are not a model
+# declining the task; a refusal is any other error_* subtype whose text also
+# reads as a refusal.
+_NON_REFUSAL_SUBTYPES = frozenset({"error_max_budget_usd", "error_max_turns"})
+
+# One tuple per kind per fleet; "*" applies to every fleet. Substrings are
+# matched case-insensitively against the fleet's own error text (`fleet_error`)
+# and conductor's own `error` field (which repeats a cut-short stream's text).
+_PATTERNS: tuple[tuple[str, str, tuple[str, ...], str], ...] = (
+    (
+        "rate_limit",
+        "*",
+        (
+            "rate limit",
+            "rate_limit",
+            "429",
+            "overloaded",
+            "529",
+            "quota",
+            "resource exhausted",
+            "too many requests",
+        ),
+        "Claude budget/rate stops, Codex/Antigravity/Cursor 429s and Anthropic's "
+        "529 'overloaded' and Google's 'resource exhausted'",
+    ),
+    (
+        "transport",
+        "*",
+        (
+            "econnreset",
+            "econnrefused",
+            "etimedout",
+            "epipe",
+            "socket hang up",
+            "fetch failed",
+            "network",
+            "502",
+            "503",
+            "504",
+        ),
+        "node/http transport failures reported by any fleet's own error text",
+    ),
+    (
+        "transport",
+        "claude",
+        ("stream ended without a result event",),
+        "outputs.py's own message for a Claude stream cut short with no final "
+        "result event (a transport-level disconnect, not a refusal)",
+    ),
+    (
+        "refusal",
+        "*",
+        ("i can't help", "i cannot help"),
+        "any fleet: the model declining the task outright, verbatim",
+    ),
+)
+
+
+def _get(result: object, name: str, default: object = None) -> object:
+    if isinstance(result, dict):
+        return result.get(name, default)
+    return getattr(result, name, default)
+
+
+def _matches(text: str, kind: str, fleet: object) -> bool:
+    for pattern_kind, pattern_fleet, substrings, _seen in _PATTERNS:
+        if pattern_kind != kind or pattern_fleet not in ("*", fleet):
+            continue
+        if any(s in text for s in substrings):
+            return True
+    return False
+
+
+def _is_refusal(fleet: object, status: object, text: str) -> bool:
+    if _matches(text, "refusal", fleet):
+        return True
+    if (
+        fleet == "claude"
+        and isinstance(status, str)
+        and status.startswith("error_")
+        and status not in _NON_REFUSAL_SUBTYPES
+        and any(s in text for s in ("refus", "cannot help", "not able to"))
+    ):
+        return True
+    return False
+
+
+def _gate_failed(result: object) -> bool:
+    """Whether the gate that counts for this dispatch ran and did not pass:
+    the clean gate when it ran, else the lane's own gate. Mirrors
+    `runner._gate_passed` without importing it, so `errors.py` stays a leaf
+    module `runner.py` can import from."""
+    surface = _get(result, "test_surface") or {}
+    clean = surface.get("clean_gate") or {}
+    tests = _get(result, "tests")
+    counted = clean if clean.get("ran") else tests
+    if not counted or not counted.get("ran"):
+        return False
+    passed = (
+        counted.get("exit_code") == 0
+        and not counted.get("timed_out")
+        and not counted.get("interrupted")
+    )
+    return not passed
+
+
+def error_kind(result: object) -> str | None:
+    """The one kind that explains why `result` is not ok, or None when it is."""
+    if _get(result, "ok"):
+        return None
+
+    error_text = str(_get(result, "error") or "")
+    if _get(result, "interrupted") or error_text.startswith("interrupted:"):
+        return "interrupted"
+    if _get(result, "cancelled") or error_text.startswith("cancelled:"):
+        return "cancelled"
+
+    budget = _get(result, "budget") or {}
+    if budget.get("exceeded") or budget.get("unpriced"):
+        return "cap"
+
+    breaker = _get(result, "breaker") or {}
+    if breaker.get("tripped"):
+        return "breaker"
+
+    if _get(result, "timed_out"):
+        return "timeout"
+
+    if error_text.startswith("setup failed") or error_text.startswith("setup timed out"):
+        return "setup"
+
+    if not _get(result, "spawned") and error_text:
+        return "refused"
+
+    fleet = _get(result, "fleet")
+    status = _get(result, "fleet_status")
+    fleet_error = str(_get(result, "fleet_error") or "")
+    combined = f"{error_text} {fleet_error}".lower()
+
+    if _matches(combined, "rate_limit", fleet):
+        return "rate_limit"
+    if _matches(combined, "transport", fleet):
+        return "transport"
+    if _is_refusal(fleet, status, combined):
+        return "refusal"
+    if fleet_error:
+        return "fleet_error"
+
+    exit_code = _get(result, "exit_code")
+    if exit_code not in (0, None):
+        return "exit"
+
+    if _gate_failed(result):
+        return "gate"
+
+    git_verdict = _get(result, "git_verdict") or {}
+    mode = _get(result, "mode")
+    no_op_ok = _get(result, "no_op_ok")
+    if (
+        mode == "write"
+        and git_verdict.get("checked")
+        and git_verdict.get("no_op")
+        and not no_op_ok
+    ):
+        return "no_op"
+    if mode == "read" and git_verdict.get("checked") and not git_verdict.get("no_op"):
+        return "read_moved_bytes"
+    if mode == "read" and exit_code is not None and not _get(result, "answer_path"):
+        return "no_answer"
+
+    commit = _get(result, "commit")
+    if commit and not commit.get("committed"):
+        nothing = commit.get("reason") == "nothing to commit"
+        if not (no_op_ok and nothing):
+            return "commit"
+
+    return "unknown"
