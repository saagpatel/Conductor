+def test_retry_recovers_on_transient_kind_then_succeeds(
+    repo: Path, home: Path, fake_fleet, tmp_path: Path
+) -> None:
+    counter_file = tmp_path / "count"
+    counter_file.write_text("0")
+    script = tmp_path / "run.sh"
+    script.write_text(
+        "#!/bin/sh\n"
+        f"n=$(cat {shlex.quote(str(counter_file))})\n"
+        "n=$((n+1))\n"
+        f"echo $n > {shlex.quote(str(counter_file))}\n"
+        "if [ $n -le 2 ]; then\n"
+        '  printf \'%s\\n\' \'{"type":"result","subtype":"error_during_execution",'
+        '"is_error":true,"errors":["fetch failed: ECONNRESET"]}\'\n"
+        "else\n"
+        '  printf \'%s\\n\' \'{"type":"result","subtype":"success","is_error":false,'
+        '"result":"ok"}\'\n"
+        "fi\n"
+    )
+    script.chmod(0o755)
+    fake_fleet(argv=["sh", str(script)])
+    mission = mission_from_dict(
+        {
+            "cwd": str(repo),
+            "retry": {"kinds": ["transport"], "attempts": 3, "backoff_s": 0},
+            "lanes": [
+                {"name": "build", "fleet": "claude", "mode": "read", "prompt": "do it"},
+            ],
+        },
+        base_dir=Path("."),
+    )
+    result = run_mission(mission, home=home)
+    lane = result.lanes[0]
+    assert lane["ok"] is True
+    assert lane["kinds"] == ["transport", "transport", None]
+    assert lane["attempts"][1]["retry_of"] == lane["attempts"][0]["run_id"]
+    assert lane["attempts"][1]["retry"] == 0
+    assert lane["attempts"][2]["retry"] == 1
+    assert counter_file.read_text().strip() == "3"
+
