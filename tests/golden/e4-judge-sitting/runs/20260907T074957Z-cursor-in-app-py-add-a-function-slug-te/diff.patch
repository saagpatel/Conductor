+
+
+def slug(text: str) -> str:
+    out: list[str] = []
+    pending_hyphen = False
+    for ch in text.lower():
+        if ch.isascii() and ch.isalnum():
+            if pending_hyphen:
+                out.append("-")
+                pending_hyphen = False
+            out.append(ch)
+        elif out:
+            pending_hyphen = True
+    return "".join(out)
