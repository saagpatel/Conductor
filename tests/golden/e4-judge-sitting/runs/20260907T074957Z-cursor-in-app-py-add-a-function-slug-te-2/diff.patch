+def slug(text: str) -> str:
+    result = []
+    hyphen = False
+    for char in text.lower():
+        if "a" <= char <= "z" or "0" <= char <= "9":
+            result.append(char)
+            hyphen = False
+        elif not hyphen:
+            result.append("-")
+            hyphen = True
+    if result and result[-1] == "-":
+        result.pop()
+    return "".join(result)
